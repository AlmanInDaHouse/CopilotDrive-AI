# Default demo; change to obd only if you have a compatible read-only serial adapter.
TELEMETRY_MODE=simulator
OBD_PORT=
OBD_BAUDRATE=38400
# Advisory only; calibrate for vehicle manufacturer's parameters.
MAX_COOLANT_C=110
# Optional OpenAI-compatible chat completion API. Never put credentials in the web frontend.
AI_API_BASE=
AI_MODEL=
AI_API_KEY=
